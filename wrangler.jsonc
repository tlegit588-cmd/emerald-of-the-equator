{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emerald-of-the-equator",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emerald-tourism",
      "database_id": "a04c7fdd-23ee-43dd-a628-1a374658e514"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "emerald-tourism-preview",
        "database_id": "84b09c72-4a91-4454-807a-3560145b7f55"
      }
    ],
    "vars": {
      "APP_ENV": "preview"
    }
  }
}
